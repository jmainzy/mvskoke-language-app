        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a551" TIME_SLOT_REF1="ts559" TIME_SLOT_REF2="ts560">
                <ANNOTATION_VALUE>vpelicet</ANNOTATION_VALUE>
