        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a289" TIME_SLOT_REF1="ts297" TIME_SLOT_REF2="ts298">
                <ANNOTATION_VALUE>Stowusis vtotket mvn toknawv hayet mowe eskērret hvtą oh-vpaket. Hvtą</ANNOTATION_VALUE>
