            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a277" TIME_SLOT_REF1="ts287" TIME_SLOT_REF2="ts288">
                <ANNOTATION_VALUE>Nak omvlkvn mvn ceyacet on owat mv vtotkvhanetskat tvlkēs mvtēkusen, you know, estit cemvhanekot. </ANNOTATION_VALUE>
