              id="t0b0d7p0s1w2"
              ARPABET="EY T OW N"
              time="149.9"
              dur="0.67"
            >eton</w> <w
              id="t0b0d7p0s1w3"
              ARPABET="D EY S"
              time="150.85"
              dur="0.3"
            >res</w> <w
