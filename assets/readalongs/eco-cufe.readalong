            id="t0b0d6p0s0"
            sentence-id="t0b0d6p0s0"
            class="sentence__translation editable__translation"
            xml:lang="eng"
          >Then he too went off a little further each time and ran off with them.</s>
                    <s id="t0b0d6p0s1"><w
              id="t0b0d6p0s1w0"
              ARPABET="M OW M EY N"
              time="136.36"
              dur="0.71"
            >Momen</w> ’<w
