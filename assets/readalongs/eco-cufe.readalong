            class="sentence__translation editable__translation"
            xml:lang="eng"
          >Deer fooled Rabbit. Long ago Rabbit had hoofs.</s>
                    <s id="t0b0d0p0s3"><w
              id="t0b0d0p0s3w0"
              ARPABET="M OW M EY N"
              time="17"
              dur="0.48"
