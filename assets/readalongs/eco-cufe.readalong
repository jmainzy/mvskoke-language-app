              ARPABET="EY Y V P EY"
              time="155.6"
              dur="0.69"
            >eyvpe</w> <w
              id="t0b0d7p0s2w3"
              ARPABET="D EY S EY HH P EY T"
              time="156.92"
              dur="0.8"
            >resehpet</w> ’<w
