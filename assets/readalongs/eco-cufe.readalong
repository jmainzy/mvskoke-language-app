            >hvtvm</w></s><s
            do-not-align="true"
            id="t0b0d2p0s0"
            sentence-id="t0b0d2p0s0"
            class="sentence__translation editable__translation"
            xml:lang="eng"
          >He went around in circles.</s>
                    <s id="t0b0d2p0s1"><w
              id="t0b0d2p0s1w0"
              ARPABET="D EY S"
              time="53.13"
              dur="0.23"
            >res</w> <w
              id="t0b0d2p0s1w1"
              ARPABET="EY N HH OW P V Y UW S EY N"
              time="53.36"
              dur="1.03"
            >enhopvyusēn</w> ’<w
              id="t0b0d2p0s1w2"
              ARPABET="S AA Y EY T"
              time="54.39"
