              ARPABET="OW HH S EY HH K EY T"
              time="151.15"
              dur="1.03"
            >ohsehket</w> <w
              id="t0b0d7p0s1w5"
              ARPABET="V Y EY P EY N HH"
              time="152.94"
              dur="0.91"
            >vyēpen,</w></s><s
            do-not-align="true"
            id="t0b0d7p0s1"
            sentence-id="t0b0d7p0s1"
            class="sentence__translation editable__translation"
            xml:lang="eng"
          >Deer caught up with him. Rabbit hung them on a tree and took off,</s>
                    <s id="t0b0d7p0s2"><w
              id="t0b0d7p0s2w0"
              ARPABET="EY CH OW"
              time="154.35"
              dur="0.3"
