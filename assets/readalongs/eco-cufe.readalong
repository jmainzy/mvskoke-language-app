              id="t0b0d4p0s0w0"
              ARPABET="M OW N T"
              time="88.72"
              dur="0.27"
            >Mont</w> <w
              id="t0b0d4p0s0w1"
              ARPABET="OW M IY S"
              time="88.99"
              dur="0.73"
            >omis</w> ’<w
              id="t0b0d4p0s0w2"
              ARPABET="T EY M"
              time="90"
              dur="0.18"
            >tem</w> <w
              id="t0b0d4p0s0w3"
              ARPABET="OW P UW N V Y EY CH V K EY K AA T EY S HH"
              time="90.18"
              dur="1.89"
            >opunvyēcvkekatēs,</w></s><s
            do-not-align="true"
            id="t0b0d4p0s0"
            sentence-id="t0b0d4p0s0"
            class="sentence__translation editable__translation"
            xml:lang="eng"
          >But they didn’t discuss it,</s>
                    <s id="t0b0d4p0s1"><w
              id="t0b0d4p0s1w0"
              ARPABET="N AA K EY"
              time="92.18"
              dur="0.64"
            >nake</w> ’<w
              id="t0b0d4p0s1w1"
              ARPABET="T EY M"
              time="93.25"
              dur="0.19"
            >tem</w> <w
              id="t0b0d4p0s1w2"
              ARPABET="V K EY D D AA K V T EY"
              time="93.44"
              dur="1.11"
            >vkerrakvtē</w> <w
              id="t0b0d4p0s1w3"
              ARPABET="OW HH F V CH CH V"
              time="94.55"
              dur="0.69"
            >ohfvccv</w> <w
              id="t0b0d4p0s1w4"
              ARPABET="T AA T"
              time="95.24"
              dur="0.24"
            >tat</w>.</s><s
            do-not-align="true"
            id="t0b0d4p0s1"
            sentence-id="t0b0d4p0s1"
            class="sentence__translation editable__translation"
            xml:lang="eng"
          >the matter of fooling each other.</s>
                    <s id="t0b0d4p0s2"><w
              id="t0b0d4p0s2w0"
              ARPABET="M OW M EY N"
              time="96.28"
              dur="0.48"
            >Momen</w> <w
              id="t0b0d4p0s2w1"
              ARPABET="CH UW F EY T"
              time="96.76"
              dur="0.45"
            >Cufet</w> <w
              id="t0b0d4p0s2w2"
              ARPABET="EY CH OW"
              time="97.8"
              dur="0.64"
            >eco</w>-<w
              id="t0b0d4p0s2w3"
              ARPABET="Y V P EY N"
              time="98.44"
              dur="0.76"
            >yvpen</w> ’<w
              id="t0b0d4p0s2w4"
              ARPABET="M EY Y AA CH EY T OW T"
              time="99.52"
              dur="1.07"
