              time="22.04"
              dur="0.91"
            >omvtēs</w>.</s><s
            do-not-align="true"
            id="t0b0d0p0s3"
            sentence-id="t0b0d0p0s3"
            class="sentence__translation editable__translation"
            xml:lang="eng"
          >And Deer had feet like Rabbit.</s>
                </p>
            <graphic url="image-eco-ton-momen-c-20261110164718-0.png" /></div>
            <div type="page" id="t0b0d1">
