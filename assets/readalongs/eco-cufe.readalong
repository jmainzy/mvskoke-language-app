            id="t0b0d2p0s1"
            sentence-id="t0b0d2p0s1"
            class="sentence__translation editable__translation"
            xml:lang="eng"
          >Then he went around with them a bit further</s>
                    <s id="t0b0d2p0s2"><w
              id="t0b0d2p0s2w0"
              ARPABET="D EY S"
              time="56.56"
