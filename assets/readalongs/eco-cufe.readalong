              time="82.14"
              dur="0.37"
            >tat</w> <w
              id="t0b0d3p0s2w2"
              ARPABET="EY N P V L EY CH EY T V N"
              time="82.95"
              dur="1.18"
            >enpvlecetvn</w> <w
              id="t0b0d3p0s2w3"
              ARPABET="K OW N T"
              time="84.13"
              dur="0.53"
            >kont</w> <w
              id="t0b0d3p0s2w4"
              ARPABET="AA D V T EY T OW T"
              time="84.88"
              dur="1.12"
            >arvtētot</w></s><s
            do-not-align="true"
            id="t0b0d3p0s2"
            sentence-id="t0b0d3p0s2"
            class="sentence__translation editable__translation"
            xml:lang="eng"
          >so Rabbit thought about getting revenge,</s>
                    <s id="t0b0d3p0s3"><w
              id="t0b0d3p0s3w0"
              ARPABET="HH V T V M"
              time="86.96"
              dur="0.18"
            >hvtvm</w> ’<w
              id="t0b0d3p0s3w1"
              ARPABET="T EY HH EY CH AA K V T EY S"
              time="87.14"
              dur="1.16"
            >tehecakvtēs</w>.</s><s
            do-not-align="true"
            id="t0b0d3p0s3"
            sentence-id="t0b0d3p0s3"
            class="sentence__translation editable__translation"
            xml:lang="eng"
          >and they saw each other again.</s>
                </p>
            <graphic url="image-eco-ton-momen-c-20261110164718-3.png" /></div>
            <div type="page" id="t0b0d4">
                <p id="t0b0d4p0">
