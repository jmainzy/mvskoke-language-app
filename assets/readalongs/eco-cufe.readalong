            sentence-id="t0b0d7p0s0"
            class="sentence__translation editable__translation"
            xml:lang="eng"
          >Now Rabbit was running pretty well with them, but unable to outrun him, </s>
                    <s id="t0b0d7p0s1"><w
              id="t0b0d7p0s1w0"
              ARPABET="EY CH OW T"
              time="147.89"
              dur="0.54"
