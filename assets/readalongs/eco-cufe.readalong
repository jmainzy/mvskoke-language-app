            >Cufe</w> <w
              id="t0b0d7p0s3w2"
              ARPABET="T AA T"
              time="161.23"
              dur="0.41"
            >tat</w> <w
              id="t0b0d7p0s3w3"
              ARPABET="EY N P OW Y AA F K V T EY S"
