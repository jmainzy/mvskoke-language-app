              time="157.98"
              dur="1.74"
            >sekohlicēpvtēs</w>.</s><s
            do-not-align="true"
            id="t0b0d7p0s2"
            sentence-id="t0b0d7p0s2"
            class="sentence__translation editable__translation"
            xml:lang="eng"
          >and Deer got his antlers and put them back on his head.</s>
                    <s id="t0b0d7p0s3"><w
              id="t0b0d7p0s3w0"
              ARPABET="M OW M EY N"
