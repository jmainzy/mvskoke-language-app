              time="138.68"
              dur="0.69"
            >omen</w> <w
              id="t0b0d6p0s1w3"
              ARPABET="EY CH OW"
              time="139.37"
              dur="0.47"
            >Eco</w> <w
              id="t0b0d6p0s1w4"
              ARPABET="K EY D D OW F HH"
              time="139.84"
              dur="0.92"
            >kērrof,</w> <w
              id="t0b0d6p0s1w5"
              ARPABET="AA S S EY CH V T EY S"
              time="141.22"
              dur="1.14"
            >assēcvtēs</w>.</s><s
            do-not-align="true"
            id="t0b0d6p0s1"
            sentence-id="t0b0d6p0s1"
            class="sentence__translation editable__translation"
            xml:lang="eng"
          >And when Deer found out that he’d gone off with them, he chased him.</s>
                </p>
            <graphic url="image-eco-ton-momen-c-20261110164718-6.png" /></div>
            <div type="page" id="t0b0d7">
                <p id="t0b0d7p0">
